# Copy this file to .env. Never commit .env.
#
# Local Mongo (docker compose up -d):
#   mongodb://127.0.0.1:27017/noir
# Atlas (hosted). Put the user and password in the URI, not in git:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/noir

MONGODB_URI=mongodb://127.0.0.1:27017/noir

# API port. Vite proxies /api to this port.
PORT=4000

# Browser origin allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Signs nothing; the session token is random and only its hash is stored.
SESSION_SECRET=replace-with-a-long-random-string

# Seed only. The API boots without these.
# If ADMIN_PASSWORD is empty when you seed, a strong password is generated and printed once.
# The seed also prints a password once for the placeholder customer customer@example.com.
# Change both. Running the seed again does not reset them.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Requests per window. Auth routes use the stricter cap.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
